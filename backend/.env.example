# ════════════════════════════════════════════════════════════════════════════
#  Backend CIUDAD — Negocios Inmobiliarios · Plantilla de variables de entorno
#  Copiá este archivo a backend/.env y completá los valores que necesites.
#  Casi todo tiene default razonable: para correr local sólo hacen falta las de
#  la sección 1. El resto activa integraciones externas (IA, Telegram, etc.).
# ════════════════════════════════════════════════════════════════════════════

# ─── 1. Núcleo (mínimo para correr) ─────────────────────────────────────────
PORT=8000
# Origenes permitidos por CORS (CSV). Sumá el puerto del frontend en dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:5273
# Base de datos. SQLite para dev local; Postgres/Supabase en producción.
DATABASE_URL=sqlite:///./ciudad.db
# Schema dedicado en Postgres (ignorado en SQLite). Default: ciudad
CIUDAD_DB_SCHEMA=ciudad
# JWT — generar con: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=ciudad-dev-secret-change-me

# ─── 2. Anthropic / Claude (IA: agentes, NLU, recomendaciones, import) ──────
# Sin esto, los agentes caen a reglas/comandos y la importación por IA se apaga.
ANTHROPIC_API_KEY=sk-ant-...
# Modelo por defecto de los agentes (admin, público, NLU, recomendaciones).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Modelo específico para importar contratos desde PDF/DOC.
ANTHROPIC_MODEL_IMPORT=claude-sonnet-4-5

# ─── 3. Telegram ────────────────────────────────────────────────────────────
# Bot principal (agente admin + agente público de leads). Token de @BotFather.
TELEGRAM_BOT_TOKEN=
# CSV de chat_id que entran como admin sin estar vinculados en la BD (dev).
# Tu chat_id lo da @userinfobot en Telegram.
TELEGRAM_ADMIN_CHATS=
# Bot separado para el módulo Ventas (opcional, si se usa uno distinto).
VENTAS_TELEGRAM_BOT_TOKEN=

# ─── 4. Meta / WhatsApp / Instagram (webhooks, preparados) ──────────────────
INSTAGRAM_VERIFY_TOKEN=ciudad_verify_token
INSTAGRAM_PAGE_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=ciudad_whatsapp_token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ─── 5. Tokko Broker (sync de propiedades) ──────────────────────────────────
TOKKO_API_KEY=
TOKKO_API_URL=https://www.tokkobroker.com/api/v1

# ─── 6. Email — comprobantes (SMTP de email_service) ────────────────────────
# Si no se configura, los PDFs igual se generan y quedan descargables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CIUDAD. <noreply@tu-dominio.com>
SMTP_TLS=true

# ─── 7. Email — notificaciones / recordatorios (notificaciones.py) ──────────
# OJO: este módulo usa otras variables (EMAIL_*), distintas de las SMTP_* de arriba.
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_SMTP=smtp.gmail.com
EMAIL_PORT=587
# Email del staff que recibe los recordatorios automáticos.
STAFF_EMAIL=

# ─── 8. Supabase Storage (adjuntos: fotos, comprobantes) ────────────────────
# Sin esto, los adjuntos caen a base64 en la DB.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── 9. Jobs / Recordatorios / operación ────────────────────────────────────
# Habilita el loop interno de recordatorios (cron). Default: apagado.
RECORDATORIOS_ENABLED=false
RECORDATORIOS_INTERVALO_SEG=3600
# Token que protege el endpoint de jobs de Ventas (/api/ventas/jobs/...).
VENTAS_JOB_TOKEN=

# ─── 9b. Scraping de webs inmobiliarias (Fase 4.1) ──────────────────────────
# Cola Redis para los jobs de scraping. Si está VACÍA, el sync corre síncrono
# dentro del request (modo dev/local). En prod: levantar un servicio worker
# aparte con  python -m app.services.ventas_scraping.worker
REDIS_URL=
# Nombre de la cola RQ (default: scraping).
SCRAPING_QUEUE=scraping
# Timeout por job de scraping en segundos.
SCRAPING_JOB_TIMEOUT=900
# Si "true", el backend sirve el build del frontend desde /static.
SERVE_FRONTEND=false
# SHA del commit, lo inyecta el deploy; se expone en /health.
GIT_SHA=

# ─── 10. Misc ───────────────────────────────────────────────────────────────
# URL del panel, usada en el email de bienvenida.
CIUDAD_PANEL_URL=https://ciudad.optimizar-ia.com
# Sitekey de reCAPTCHA para la consulta de tasas MSR (si aplica).
MSR_RECAPTCHA_SITEKEY=
